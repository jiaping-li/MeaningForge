  "work": { "id": "lu_xun_aq", "title": "阿Q正传", "author": "鲁迅", "language": "zh", "edition_id": "aq-ed-public-domain-01", "source_description": "本地 public-domain 文本；development package。", "source_uri": "/books/luxun-aq-zh.txt", "status": "development", "chapter_markers": [{ "id": "2", "label": "第二章 优胜记略", "marker": "第二章 优胜记略" }] },
  "text_spans": [
    { "id": "aq_s01", "work_id": "lu_xun_aq", "chapter_id": "2", "paragraph_id": "p56", "order": 56, "text": "阿Q在形式上打败了，被人揪住黄辫子，在壁下碰了四五个响头，闲人这才心满意足的得胜的走了，阿Q站了一刻，心里想，『我总算被儿子打了，现在的世界真不像样……』于是也心满意足的得胜的走了。", "provenance_id": "aq_p_text", "status": "grounding_validated" },
    { "id": "aq_s02", "work_id": "lu_xun_aq", "chapter_id": "2", "paragraph_id": "p58", "order": 58, "text": "阿Q想在心里的，后来每每说出口来，所以凡有和阿Q玩笑的人们，几乎全知道他有这一种精神上的胜利法，此后每逢揪住他黄辫子的时候，人就先一着对他说：", "provenance_id": "aq_p_text", "status": "grounding_validated" },
    { "id": "aq_s03", "work_id": "lu_xun_aq", "chapter_id": "2", "paragraph_id": "p60", "order": 60, "text": "『阿Q，这不是儿子打老子，是人打畜生。自己说，人打畜生！』", "provenance_id": "aq_p_text", "status": "grounding_validated" },
    { "id": "aq_s04", "work_id": "lu_xun_aq", "chapter_id": "2", "paragraph_id": "p62", "order": 62, "text": "但虽然是虫豸，闲人也并不放，仍旧在就近什么地方给他碰了五六个响头，这才心满意足的得胜的走了，他以为阿Q这回可遭了瘟。然而不到十秒钟，阿Q也心满意足的得胜的走了，", "provenance_id": "aq_p_text", "status": "grounding_validated" }
  ],
  "evidence": [
    { "id": "aq_e01", "work_id": "lu_xun_aq", "span_ids": ["aq_s01"], "type": "action", "note": "身体失败与“得胜”在同一段中并置。", "provenance_id": "aq_p_text", "status": "grounding_validated" },
    { "id": "aq_e02", "work_id": "lu_xun_aq", "span_ids": ["aq_s02"], "type": "repetition", "note": "这套说法被反复说出，也被旁人知晓。", "provenance_id": "aq_p_text", "status": "grounding_validated" },
    { "id": "aq_e03", "work_id": "lu_xun_aq", "span_ids": ["aq_s03", "aq_s04"], "type": "dialogue", "note": "旁人接管并重复这套关系命名。", "provenance_id": "aq_p_text", "status": "grounding_validated" }
  ],
