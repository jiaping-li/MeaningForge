  "text_spans": [
    { "id": "s01", "work_id": "lu_xun_medicine", "chapter_id": "1", "paragraph_id": "p24", "order": 24, "text": "‘喂！一手交钱，一手交货！’一个浑身黑色的人，站在老栓面前，眼光正像两把刀。刺得老栓缩小了一半。那人一只大手，向他摊着；一只手却撮着一个鲜红的馒头，那红的还是一点一点的往下滴。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s02", "work_id": "lu_xun_medicine", "chapter_id": "1", "paragraph_id": "p26", "order": 26, "text": "黑的人便抢过灯笼，一把扯下纸罩，裹了馒头，塞与老栓；一手抓过洋钱，捏一捏，转身去了。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s03", "work_id": "lu_xun_medicine", "chapter_id": "2", "paragraph_id": "p40", "order": 40, "text": "‘吃下去罢，——病便好了。’", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s04", "work_id": "lu_xun_medicine", "chapter_id": "2", "paragraph_id": "p42", "order": 42, "text": "焦皮里面窜出一道白气，白气散了，是两半个白面的馒头。——不多工夫，已经全在肚里了，却全忘了什么味；面前只剩下一张空盘。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s05", "work_id": "lu_xun_medicine", "chapter_id": "3", "paragraph_id": "p62", "order": 62, "text": "‘这是包好！这是与众不同的。你想，趁热的拿来，趁热吃下。’横肉的人只是嚷。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s06", "work_id": "lu_xun_medicine", "chapter_id": "3", "paragraph_id": "p66", "order": 66, "text": "‘包好，包好！这样的趁热吃下。这样的人血馒头，什么痨病都包好！’", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s07", "work_id": "lu_xun_medicine", "chapter_id": "3", "paragraph_id": "p76", "order": 76, "text": "‘包好，包好！’康大叔瞥了小栓一眼，仍然回过脸，对众人说，‘夏三爷真是乖角儿，要是他不先告官，连他满门抄斩。现在怎样？银子！——这小东西也真不成东西！关在牢里，还要劝牢头造反。’", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s08", "work_id": "lu_xun_medicine", "chapter_id": "3", "paragraph_id": "p98", "order": 98, "text": "‘包好！小栓——你不要这么咳。包好！’", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s09", "work_id": "lu_xun_medicine", "chapter_id": "4", "paragraph_id": "p110", "order": 110, "text": "路的左边，都埋着死刑和瘦毙的人，右边是穷人的丛冢。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s10", "work_id": "lu_xun_medicine", "chapter_id": "4", "paragraph_id": "p116", "order": 116, "text": "分明有一圈红白的花，围着那尖圆的坟顶。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s11", "work_id": "lu_xun_medicine", "chapter_id": "4", "paragraph_id": "p118", "order": 118, "text": "这没有根，不像自己开的！这地方有谁来呢？孩子不会来玩；——亲戚本家早不来了。——这是怎么一回事呢？", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s12", "work_id": "lu_xun_medicine", "chapter_id": "4", "paragraph_id": "p120", "order": 120, "text": "只见一只乌鸦，站在一株没有叶的树上", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "s13", "work_id": "lu_xun_medicine", "chapter_id": "4", "paragraph_id": "p130", "order": 130, "text": "只见那乌鸦张开两翅，一挫身，直向着远处的天空，箭也似的飞去了。", "provenance_id": "p_text", "status": "grounding_validated" }
  ],
  "evidence": [
    { "id": "e01", "work_id": "lu_xun_medicine", "span_ids": ["s01"], "type": "object_description", "note": "交易现场的鲜红馒头。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e02", "work_id": "lu_xun_medicine", "span_ids": ["s02"], "type": "action", "note": "馒头被包裹并交给老栓。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e03", "work_id": "lu_xun_medicine", "span_ids": ["s03", "s04"], "type": "action", "note": "小栓吃下被当作药的馒头。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e04", "work_id": "lu_xun_medicine", "span_ids": ["s05", "s06", "s08"], "type": "repetition", "note": "“包好”在茶馆情境中反复出现。", "provenance_id": "p_structural", "status": "grounding_validated" },
    { "id": "e05", "work_id": "lu_xun_medicine", "span_ids": ["s07"], "type": "dialogue", "note": "茶馆谈话将夏瑜的处境纳入公共议论。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e06", "work_id": "lu_xun_medicine", "span_ids": ["s09"], "type": "scene", "note": "坟地以一条路分隔两侧坟墓。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e07", "work_id": "lu_xun_medicine", "span_ids": ["s10", "s11"], "type": "sensory_image", "note": "红白花环出现，其来源被人物追问。", "provenance_id": "p_text", "status": "grounding_validated" },
    { "id": "e08", "work_id": "lu_xun_medicine", "span_ids": ["s12", "s13"], "type": "sensory_image", "note": "乌鸦先静止、后飞离。", "provenance_id": "p_text", "status": "grounding_validated" }
  ],
  "narrative_units": [
    { "id": "u01", "work_id": "lu_xun_medicine", "order": 1, "chapter_id": "1", "span_ids": ["s01", "s02"], "summary": "老栓在交易中取得馒头。", "provenance_id": "p_narrative", "status": "reference_ready" },
    { "id": "u02", "work_id": "lu_xun_medicine", "order": 2, "chapter_id": "2", "span_ids": ["s03", "s04"], "summary": "小栓被要求吃下馒头。", "provenance_id": "p_narrative", "status": "reference_ready" },
    { "id": "u03", "work_id": "lu_xun_medicine", "order": 3, "chapter_id": "3", "span_ids": ["s05", "s06", "s07", "s08"], "summary": "茶馆谈话反复确认疗效，并议论夏瑜。", "provenance_id": "p_narrative", "status": "reference_ready" },
    { "id": "u04", "work_id": "lu_xun_medicine", "order": 4, "chapter_id": "4", "span_ids": ["s09", "s10", "s11", "s12", "s13"], "summary": "坟地使两处死亡和结尾意象并置。", "provenance_id": "p_narrative", "status": "reference_ready" }
