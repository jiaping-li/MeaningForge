    { "id": "sr03", "work_id": "lu_xun_medicine", "thread_id": "t_blood_treatment", "source_id": "c_treatment_speech", "target_id": "c_blood_bun", "type": "changes_function", "evidence_ids": ["e04"], "rationale": "“包好”的反复话语将馒头置入被保证有效的治疗语境。", "provenance_id": "p_structural", "status": "reference_ready" },
    { "id": "sr04", "work_id": "lu_xun_medicine", "thread_id": "t_public_talk", "source_id": "c_treatment_speech", "target_id": "n_public_talk", "type": "recurs_with", "evidence_ids": ["e04", "e05"], "rationale": "疗效承诺在茶馆谈话中被重复，并与夏瑜的议论处于同一谈话场景。", "provenance_id": "p_structural", "status": "reference_ready" },
