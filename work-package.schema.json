{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meaningforge.local/schema/work-package-1.0.json",
  "title": "MeaningForge WorkPackage",
  "type": "object",
  "required": ["schema_version", "package_id", "package_status", "work", "text_spans", "evidence", "narrative_units", "narrative_entities", "narrative_relations", "figurative_features", "carriers", "threads", "structural_relations", "interpretive_relations", "probes", "provenance"],
  "properties": {
    "schema_version": { "const": "meaningforge-1.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "package_status": { "enum": ["draft", "development", "pilot_ready", "study_ready"] },
    "work": { "$ref": "#/$defs/work" },
    "text_spans": { "type": "array", "items": { "$ref": "#/$defs/textSpan" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "narrative_units": { "type": "array", "items": { "$ref": "#/$defs/narrativeUnit" } },
    "narrative_entities": { "type": "array", "items": { "$ref": "#/$defs/narrativeEntity" } },
    "narrative_relations": { "type": "array", "items": { "$ref": "#/$defs/narrativeRelation" } },
    "figurative_features": { "type": "array", "items": { "$ref": "#/$defs/figurativeFeature" } },
    "carriers": { "type": "array", "items": { "$ref": "#/$defs/carrier" } },
    "threads": { "type": "array", "items": { "$ref": "#/$defs/thread" } },
    "structural_relations": { "type": "array", "items": { "$ref": "#/$defs/structuralRelation" } },
    "interpretive_relations": { "type": "array", "items": { "$ref": "#/$defs/interpretiveRelation" } },
    "probes": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
    "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "provenanced": { "type": "object", "required": ["id", "provenance_id", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "provenance_id": { "$ref": "#/$defs/id" }, "status": { "enum": ["candidate", "schema_validated", "grounding_validated", "reference_ready", "pilot_ready", "study_ready", "rejected"] } } },
    "work": { "type": "object", "required": ["id", "title", "language", "edition_id", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "author": { "type": "string" }, "language": { "type": "string" }, "edition_id": { "$ref": "#/$defs/id" }, "source_description": { "type": "string" }, "source_uri": { "type": "string" }, "status": { "enum": ["draft", "development", "pilot_ready", "study_ready"] } } },
    "textSpan": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "order", "text"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "chapter_id": { "type": "string" }, "paragraph_id": { "type": "string" }, "sentence_id": { "type": "string" }, "order": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "minLength": 1 }, "start_offset": { "type": "integer", "minimum": 0 }, "end_offset": { "type": "integer", "minimum": 0 } } }] },
    "evidence": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "span_ids", "type"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "span_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "type": { "enum": ["object_description", "action", "dialogue", "scene", "sensory_image", "repetition", "contrast", "consequence", "character_relation", "contextual_event"] }, "note": { "type": "string" } } }] },
    "narrativeUnit": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "order", "span_ids"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "order": { "type": "integer", "minimum": 0 }, "chapter_id": { "type": "string" }, "span_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "summary": { "type": "string" } } }] },
    "narrativeEntity": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "type", "label", "evidence_ids"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "type": { "enum": ["character", "object", "event", "action", "scene", "discourse", "place"] }, "label": { "type": "string" }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } }] },
    "narrativeRelation": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "source_id", "target_id", "type", "evidence_ids"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "source_id": { "$ref": "#/$defs/id" }, "target_id": { "$ref": "#/$defs/id" }, "type": { "enum": ["participates_in", "performed_by", "acts_on", "occurs_in", "precedes", "causes", "results_in", "associated_with", "spoken_by", "directed_to"] }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } }] },
    "figurativeFeature": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "evidence_id", "surface_form", "type"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "evidence_id": { "$ref": "#/$defs/id" }, "surface_form": { "type": "string" }, "type": { "enum": ["metaphor_related", "recurrent_imagery", "symbolic_object_candidate", "narrative_pattern", "discourse_pattern"] }, "mip_status": { "enum": ["applicable", "not_applicable", "uncertain"] }, "mip_record": { "type": "object", "properties": { "lexical_unit": { "type": "string" }, "contextual_meaning": { "type": "string" }, "basic_meaning": { "type": "string" }, "contrast_present": { "type": "boolean" }, "comparison_defensible": { "type": "boolean" } } } } }] },
    "carrier": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "label", "type", "feature_ids", "evidence_ids", "selection_reasons"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "type": { "enum": ["object", "action", "discourse", "scene_ritual", "sensory_image", "recurrent_expression", "conceptual_feature"] }, "feature_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "selection_reasons": { "type": "array", "minItems": 2, "items": { "enum": ["observability", "recurrence_distribution", "narrative_salience", "relational_load", "interpretive_tension", "reader_actionability", "probe_potential"] } } } }] },
    "thread": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "neutral_label", "carrier_ids", "feature_ids", "evidence_ids", "structural_relation_ids", "interpretive_relation_ids"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "neutral_label": { "type": "string" }, "carrier_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "feature_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "structural_relation_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "interpretive_relation_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "distribution": { "type": "object" } } }] },
    "structuralRelation": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "source_id", "target_id", "type", "evidence_ids", "rationale"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "thread_id": { "$ref": "#/$defs/id" }, "source_id": { "$ref": "#/$defs/id" }, "target_id": { "$ref": "#/$defs/id" }, "type": { "enum": ["recurs_with", "contrasts_with", "parallels", "co_occurs_with", "precedes", "follows", "changes_context", "changes_function", "shares_actor", "shares_scene", "causal_link", "consequence_link"] }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "rationale": { "type": "string", "minLength": 1 } } }] },
    "interpretiveRelation": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "source_ids", "type", "evidence_ids", "grounding_relation_ids", "relation_text", "qualification"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "thread_id": { "$ref": "#/$defs/id" }, "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "type": { "enum": ["supports", "complicates", "weakens", "qualifies", "possible_implication", "alternative_to", "reframes"] }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "grounding_relation_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "relation_text": { "type": "string", "minLength": 1 }, "qualification": { "type": "string", "minLength": 1 } } }] },
    "probe": { "allOf": [{ "$ref": "#/$defs/provenanced" }, { "type": "object", "required": ["work_id", "type", "target_relation_ids", "prompt"], "properties": { "work_id": { "$ref": "#/$defs/id" }, "thread_id": { "$ref": "#/$defs/id" }, "type": { "enum": ["edge_removal", "replacement", "alternative_path"] }, "target_relation_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "target_carrier_id": { "$ref": "#/$defs/id" }, "prompt": { "type": "string", "minLength": 1 }, "config": { "type": "object" } } }] },
    "provenance": { "type": "object", "required": ["id", "method_basis", "executor_type"], "properties": { "id": { "$ref": "#/$defs/id" }, "method_basis": { "enum": ["DIRECT_TEXT", "MIP_MIPVU_INFORMED", "NARRATIVE_RULE", "STRUCTURAL_RULE", "SCHOLARSHIP", "REFERENCE_INTERPRETIVE_PROTOCOL", "READER_REASONING"] }, "executor_type": { "enum": ["DETERMINISTIC", "LLM", "HUMAN", "IMPORTED", "READER"] }, "executor_name": { "type": "string" }, "model_name": { "type": "string" }, "model_version": { "type": "string" }, "prompt_protocol_version": { "type": "string" }, "source_refs": { "type": "array", "items": { "type": "string" } }, "method_note": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "created_at": { "type": "string" } } }
  }
}
